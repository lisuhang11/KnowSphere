# ===== SiliconFlow（默认远程厂商，chat + embedding 可走它）=====
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 本地 Ollama（模型管理里选「本地」）。Docker 访问宿主机用 host.docker.internal
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# 模型选择（以 SiliconFlow 控制台最新模型 ID 为准）
CHAT_PROVIDER=siliconflow
CHAT_MODEL=Qwen/Qwen3-32B
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== 模型管理 =====
# models 表 api_key 加密主密钥（AES-256-GCM）。生产必须设置！
# 未设置时降级为可逆 base64（仅限开发）。变更后运行：
#   MASTER_KEY_NEW=<新密钥> python -m scripts.reencrypt_models
MASTER_KEY=change-me-to-a-strong-random-key

# ===== Langfuse（对话 / 摄取 tracing；不配密钥则关闭，不影响业务）=====
# Cloud: https://cloud.langfuse.com  控制台创建项目后填公钥/私钥
# 自托管: git clone https://github.com/langfuse/langfuse && docker compose up
#         然后 LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# ===== 存储 =====
POSTGRES_DSN=postgresql://knowsphere:knowsphere@localhost:5432/knowsphere
# Celery broker + 会话续流事件（RPUSH/LRANGE）。多开 uvicorn 时必须可达。
REDIS_URL=redis://localhost:6379/0
# 续流存储：redis（默认）| memory。Redis 不可用时自动降级 memory。
STREAM_MANAGER_TYPE=redis
STREAM_TTL_SEC=3600
STREAM_KEY_PREFIX=ks:stream
# 文档原文件存 MinIO（docker compose up -d minio）；新上传不再写本地目录
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowsphere
# 仅存量本地上传文档回退读取（新上传可忽略）
UPLOAD_DIR=data/uploads

# ===== 检索/切块 =====
CHUNK_SIZE=600
CHUNK_OVERLAP=90
# 父子分块（默认关闭；KB 级可覆盖，开启后需 reparse 已有文档）
ENABLE_PARENT_CHILD=false
PARENT_CHUNK_SIZE=4096
CHILD_CHUNK_SIZE=384
RETRIEVAL_TOP_K=6
HYBRID_LEX_WEIGHT=0.4
RETRIEVAL_CANDIDATE_K=30

# ===== 重排 =====
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DEFAULT_OWNER=default
MMR_ENABLED=true
MMR_LAMBDA=0.7

# Query understanding
ENABLE_REWRITE=true
MAX_REWRITE_ROUNDS=8
# QUERY_UNDERSTAND_MODEL=   # 空则复用 CHAT_MODEL

# 短期记忆（LLM 视图压缩；checkpoint 仍存全文）
STM_MAX_CONTEXT_TOKENS=32000
STM_KEEP_TURNS=8
STM_CONSOLIDATE_RATIO=0.5
STM_HARD_TRIM_RATIO=0.8
STM_REDACT_OLD_RETRIEVAL=true
STM_WORKING_MEMORY_MAX_CHARS=1200

# 长期记忆（跨会话画像/兴趣/常查资料，注入 query_understand）
MEMORY_ENABLED=true
MEMORY_RETRIEVAL_CONDITIONING=true

# 会话图片
CHAT_IMAGES_ENABLED=true
# VLM_MODEL=                # 可选：启动时 seed 为内置 VLLM（如 Qwen/Qwen2-VL-7B-Instruct）
# CHAT_VLM_MODEL_ID=        # 全局默认 VLLM 模型 ID；空则使用 models 表 is_default 的 VLLM
CHAT_ATTACHMENT_TTL_HOURS=24
CHAT_ATTACHMENT_WAIT_SEC=60

# 本地 query expansion（召回不足时，无 LLM）
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MAX_VARIANTS=5

# LLM 多跳子查询（默认关；复杂多跳问题可开）
MULTI_QUERY_ENABLED=false
MULTI_QUERY_COUNT=3

# 联网搜索：管理员总开关。true 时聊天输入框可开/关联网；false 则不绑定 web_search / web_fetch
# 默认 Bing HTML（国内可达）；DuckDuckGo 仅作短超时回退。可选 SearXNG / 代理。
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SEC=8
# WEB_SEARCH_PROXY=http://127.0.0.1:7890
# WEB_SEARCH_SEARXNG_URL=http://127.0.0.1:8888
WEB_FETCH_TIMEOUT_SEC=15
WEB_FETCH_MAX_BYTES=512000

# 技能沙箱（一次性 docker run，默认无网）。无 Docker 时脚本工具会报错，不会在 API 进程执行。
# SKILL_SANDBOX_IMAGE=python:3.12-slim
# 需要 pypdf 等库时可：docker build -t knowsphere-skill:latest sandbox
# SKILL_SANDBOX_IMAGE=knowsphere-skill:latest
# SKILL_SANDBOX_TIMEOUT_SEC=60
# SKILL_SANDBOX_MEMORY=512m

# ===== 知识图谱（Neo4j，可选）=====
# 启用：NEO4J_ENABLE=true 且 docker compose --profile neo4j up -d
# 知识库设置里还需打开「知识图谱」开关，入库后才会抽取实体关系
NEO4J_ENABLE=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
